;; finanse connector sandbox profile (macOS sandbox-exec, SBPL), rendered per run by
;; finanse.core.connectors.sandbox.render_profile. The dollar-brace placeholders are filled with escaped, real
;; (symlink-free) paths; nothing else is substituted. Comments start with ";".
;;
;; Everything is denied unless allowed below. A connector can read the system, its own directory, its
;; interpreter's installation and its run directory; it can write only the run directory; it cannot
;; reach the network, except a fetch connector, which can reach the app's egress proxy on localhost.
(version 1)
(deny default)

;; Processes: the interpreter (and, for a framework / keg layout, its installation, e.g. the Homebrew
;; Python stub that spawns Resources/Python.app) and executables inside the connector directory.
(allow process-fork)
(allow process-exec
  ${EXEC_RULES})
(allow signal (target same-sandbox))
(allow sysctl-read)

;; dyld aborts the process (SIGABRT) without reading "/" and stat-ing the ancestors of every path it
;; loads from, and the Python framework stub realpath()s its own location: metadata only (existence,
;; size, times) of the ancestors, never their contents or listings; "/" itself is listable.
(allow file-read* (literal "/"))
(allow file-read-metadata
  (literal "/etc") (literal "/tmp") (literal "/var")
  ${METADATA_RULES})

;; System locations (read only). Not /Library (python3 and node need none of it; an interpreter
;; installed there, e.g. the Command Line Tools python, is covered by the interpreter prefix rule) and
;; not the user's home.
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/System")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (subpath "/opt/homebrew")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (literal "/dev/random")
  ${READ_RULES})

;; Keychains: never, whatever an allow rule above covers (later rules win).
(deny file-read* file-write*
  (subpath "/Library/Keychains"))

;; Writes: the run directory (cwd = HOME = TMPDIR) and /dev/null only.
(allow file-write*
  (literal "/dev/null")
  ${WRITE_RULES})

;; mach-lookup: NONE. Found empirically (macOS 15.7, arm64): Homebrew python3 3.14, Xcode python3 3.9
;; and node 23 start and run with no mach service at all. The only lookups they attempt are
;; com.apple.system.notification_center and com.apple.system.opendirectoryd.libinfo (getpwuid), both
;; harmless to deny. Never allow com.apple.SecurityServer, com.apple.securityd*, com.apple.pasteboard*
;; or com.apple.windowserver*.

;; Network: none for file connectors; a fetch connector reaches only the egress proxy (no DNS: the proxy
;; resolves the allowed hosts itself).
${NETWORK_RULES}
