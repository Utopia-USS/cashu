{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cashu-import.v1.json",
  "title": "cashU investments import document (cashu-import), format_version 1",
  "description": "Built from cashu.modules.investments.importing.canonical by scripts/gen_connector_schemas.py; see import-format.md (also the CSV variant). The app also enforces what a schema cannot express: real calendar dates, the instrument and quantity rules per transaction type, cash sign rules, gross / fee / tax / cash consistency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "records"
  ],
  "properties": {
    "format": {
      "const": "cashu-import"
    },
    "format_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 32
    },
    "account_hint": {
      "type": "string",
      "maxLength": 200
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "record",
        "date"
      ],
      "properties": {
        "record": {
          "enum": [
            "txn",
            "position",
            "rename",
            "delisting"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
        },
        "settle_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "type": {
          "enum": [
            "buy",
            "sell",
            "dividend",
            "deposit",
            "withdrawal",
            "fee",
            "tax",
            "interest",
            "fx_conversion",
            "split",
            "transfer_in",
            "transfer_out",
            "adjustment"
          ]
        },
        "external_ref": {
          "type": "string",
          "maxLength": 200
        },
        "symbol": {
          "type": "string",
          "maxLength": 64
        },
        "isin": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "exchange": {
          "type": "string",
          "maxLength": 64
        },
        "quantity": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "price": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "gross_amount": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "fee": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "tax": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "cash_amount": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "cash_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "fx_rate": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "split_ratio": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "avg_price": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "market_value": {
          "description": "a decimal number: a JSON number or a string with '.' as decimal separator",
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
            }
          ]
        },
        "new_symbol": {
          "type": "string",
          "maxLength": 64
        },
        "new_isin": {
          "type": "string",
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"
        },
        "new_exchange": {
          "type": "string",
          "maxLength": 64
        },
        "new_name": {
          "type": "string",
          "maxLength": 200
        },
        "frozen": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "true",
                "false"
              ]
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "record": {
                "const": "txn"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "record",
                "date",
                "time",
                "settle_date",
                "type",
                "external_ref",
                "symbol",
                "isin",
                "name",
                "exchange",
                "quantity",
                "price",
                "currency",
                "gross_amount",
                "fee",
                "tax",
                "cash_amount",
                "cash_currency",
                "fx_rate",
                "split_ratio",
                "note"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "record": {
                "const": "position"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "record",
                "date",
                "symbol",
                "isin",
                "name",
                "exchange",
                "quantity",
                "currency",
                "avg_price",
                "market_value",
                "note"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "record": {
                "const": "rename"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "record",
                "date",
                "symbol",
                "isin",
                "exchange",
                "new_symbol",
                "new_isin",
                "new_exchange",
                "new_name",
                "note"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "record": {
                "const": "delisting"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "record",
                "date",
                "symbol",
                "isin",
                "exchange",
                "frozen",
                "note"
              ]
            }
          }
        }
      ]
    }
  }
}
