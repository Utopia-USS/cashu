{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connector-manifest.v1.json",
  "title": "finanse connector manifest (connector.yaml), api_version 1",
  "description": "Generated from finanse.core.connectors.manifest.Manifest by scripts/gen_connector_schemas.py; see connectors.md. The app also enforces the rules a schema cannot express: run[0] is an allowed interpreter or ./<file>, no `..` or absolute paths in run, the file / fetch section matches kind, unique ids, directory limits.",
  "$defs": {
    "FetchSpec": {
      "additionalProperties": false,
      "description": "``kind: fetch``: the hosts the egress proxy allows (port 443 only), secrets and params.",
      "properties": {
        "hosts": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Hosts",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretSpec"
          },
          "maxItems": 5,
          "title": "Secrets",
          "type": "array"
        },
        "params": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParamSpec"
          },
          "maxItems": 10,
          "title": "Params",
          "type": "array"
        },
        "history_days": {
          "default": 365,
          "maximum": 3650,
          "minimum": 1,
          "title": "History Days",
          "type": "integer"
        }
      },
      "required": [
        "hosts"
      ],
      "title": "FetchSpec",
      "type": "object"
    },
    "FileSpec": {
      "additionalProperties": false,
      "description": "``kind: file``: the export file extensions the connector converts.",
      "properties": {
        "extensions": {
          "items": {
            "pattern": "^[a-z0-9]{1,10}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Extensions",
          "type": "array"
        }
      },
      "required": [
        "extensions"
      ],
      "title": "FileSpec",
      "type": "object"
    },
    "ParamSpec": {
      "additionalProperties": false,
      "description": "A non-secret setting of a binding.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "date",
            "number",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "ParamSpec",
      "type": "object"
    },
    "SecretSpec": {
      "additionalProperties": false,
      "description": "A secret the owner enters once per binding (stored in the OS keychain, given only on stdin).",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "SecretSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": 1,
      "title": "Api Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{1,39}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 60,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "maxLength": 20,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 280,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "module": {
      "enum": [
        "investments",
        "budget"
      ],
      "title": "Module",
      "type": "string"
    },
    "kind": {
      "enum": [
        "file",
        "fetch"
      ],
      "title": "Kind",
      "type": "string"
    },
    "run": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Run",
      "type": "array"
    },
    "timeout_s": {
      "default": 60,
      "maximum": 600,
      "minimum": 1,
      "title": "Timeout S",
      "type": "integer"
    },
    "file": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fetch": {
      "anyOf": [
        {
          "$ref": "#/$defs/FetchSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "api_version",
    "id",
    "name",
    "version",
    "module",
    "kind",
    "run"
  ],
  "type": "object"
}
