# Copy to .env and fill in. .env is git-ignored — it never lands in the repo.
#   cp .env.example .env
#
# Every variable is prefixed with FINANSE_. Everything is OPTIONAL: by default
# the database is data/finanse.db, LLM categorization is off, and Open Banking
# is only needed when you want live sync.

# --- Database ----------------------------------------------------------------
# SQLite file kept locally. Financial data never leaves your machine.
FINANSE_DATABASE_URL=sqlite:///data/finanse.db

# --- Categorization (LLM optional; deterministic rules always run) -----------
# Enable the LLM for unknown merchants. Off by default — the PL rules are enough
# to get started.
FINANSE_CATEGORIZE_USE_LLM=false
# LLM backend: "ollama" (local, offline, default) or "anthropic" (cloud).
FINANSE_CATEGORIZE_LLM_BACKEND=ollama

# ollama backend (local, nothing leaves the machine):
FINANSE_CATEGORIZE_OLLAMA_MODEL=qwen2.5:3b
FINANSE_CATEGORIZE_OLLAMA_URL=http://localhost:11434

# anthropic backend (cloud) — sends ONLY the merchant string, never IBANs,
# balances, or names:
FINANSE_CATEGORIZE_MODEL=claude-haiku-4-5
FINANSE_ANTHROPIC_API_KEY=

# --- Enable Banking (Open Banking / PSD2) — OPTIONAL -------------------------
# Only needed for live sync. NOT required for plain CSV import.
# Register a free "Restricted Production" app at https://enablebanking.com/cp/
# You generate the RSA key pair yourself; keep the private key local (in data/).
FINANSE_EB_APP_ID=
# Path to the RSA private key PEM (relative to the repo, or absolute).
FINANSE_EB_KEY_PATH=data/enablebanking_private.pem
FINANSE_EB_BASE_URL=https://api.enablebanking.com
# The redirect URL must be https (EB rejects http). `eb login` serves it locally
# with a self-signed cert (accept the browser warning once).
FINANSE_EB_REDIRECT_URL=https://localhost:8000/eb/callback
# Two-letter country code of your banks.
FINANSE_EB_COUNTRY=PL
