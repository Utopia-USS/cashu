# Copy to .env and fill in. .env is git-ignored — it never lands in the repo.
#   cp .env.example .env
#
# Every variable is prefixed with CASHU_. Everything is OPTIONAL: by default
# the database lives in the per-user data dir (macOS ~/Library/Application
# Support/cashU, Windows %APPDATA%\cashU, Linux ~/.local/share/cashu), LLM
# categorization is off, and Open Banking is only needed when you want live sync.

# --- Data dir / database -----------------------------------------------------
# Folder for the DB, Open Banking sessions and key, backups (default: see above).
# CASHU_DATA_DIR=/absolute/path/to/cashu-data
# SQLite file kept locally. Financial data never leaves your machine. Only set
# this to use a database outside the data dir.
# CASHU_DATABASE_URL=sqlite:////absolute/path/to/cashu.db

# --- Dashboard server (`cashu serve`) ---------------------------------------
# Loopback only by default; every API call needs a per-launch token.
# CASHU_HOST=127.0.0.1
# CASHU_PORT=8500

# --- Categorization (LLM optional; deterministic rules always run) -----------
# Enable the LLM for unknown merchants. Off by default — the PL rules are enough
# to get started.
CASHU_CATEGORIZE_USE_LLM=false
# LLM backend: "ollama" (local, offline, default) or "anthropic" (cloud).
CASHU_CATEGORIZE_LLM_BACKEND=ollama

# ollama backend (local, nothing leaves the machine):
CASHU_CATEGORIZE_OLLAMA_MODEL=qwen2.5:3b
CASHU_CATEGORIZE_OLLAMA_URL=http://localhost:11434

# anthropic backend (cloud) - sends ONLY the merchant string, never IBANs,
# balances, or names. Store the key in the OS keychain instead of here:
#   cashu secrets set anthropic
# (CASHU_ANTHROPIC_API_KEY below is only a fallback for CI / development.)
CASHU_CATEGORIZE_MODEL=claude-haiku-4-5
CASHU_ANTHROPIC_API_KEY=

# --- Enable Banking (Open Banking / PSD2) — OPTIONAL -------------------------
# Only needed for live sync. NOT required for plain CSV import.
# Register a free "Restricted Production" app at https://enablebanking.com/cp/
# You generate the RSA key pair yourself; keep the private key local (by default
# <data dir>/enablebanking_private.pem).
CASHU_EB_APP_ID=
# Only if the RSA private key PEM lives elsewhere (absolute path):
# CASHU_EB_KEY_PATH=/absolute/path/to/enablebanking_private.pem
CASHU_EB_BASE_URL=https://api.enablebanking.com
# The redirect URL must be https (EB rejects http). `eb login` serves it locally
# with a self-signed cert (accept the browser warning once).
CASHU_EB_REDIRECT_URL=https://localhost:8000/eb/callback
# Two-letter country code of your banks.
CASHU_EB_COUNTRY=PL

# --- App update check ---
# The dashboard shows a notice when project.version of pyproject.toml on this
# GitHub branch is higher than the running version (one anonymous GET, nothing sent).
# CASHU_UPDATE_CHECK=false
CASHU_UPDATE_REPO=Utopia-USS/cashu
CASHU_UPDATE_BRANCH=main
