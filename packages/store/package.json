    "./investments/views": "./src/investments/views/index.ts",
    "./investments/services": "./src/investments/services/index.ts",
    "./investments/local": "./src/investments/local/index.ts",
    "./device": "./src/device/index.ts",
    "./bridge": "./src/bridge/index.ts",
    "./genesis": "./src/genesis/index.ts",
    "./overview": "./src/overview/index.ts",
    "./query": "./src/query.ts",
    "./ui-actions": "./src/ui-actions.ts",
