{
  "name": "@cashu/store-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "React bindings over the event store (useQuery, useCommand, providers) and the store port between the desktop renderer and the store process.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./host": "./src/host/index.ts",
    "./local": "./src/local/index.ts",
    "./protocol": "./src/protocol/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:exhaustive": "CASHU_TEST_TIER=exhaustive vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cashu/domain": "workspace:*",
    "@cashu/store": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "13.0.3",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
