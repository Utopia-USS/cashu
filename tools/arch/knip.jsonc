// Knip: unused files, exports, types and dependencies of the TypeScript workspaces.
// Run from the repo root by `pnpm arch:check` (tools/arch/src/run.ts).
{
  "$schema": "../../node_modules/.pnpm/knip@6.41.0/node_modules/knip/schema-jsonc.json",
  // TRANSITIONAL(frontend-retirement): the legacy SPA in frontend/ is a workspace member only so that its imports
  // count as uses of @cashu/i18n and @cashu/ui-logic; its own dead code was never under these checks (nor under
  // Biome or dependency-cruiser) and is not reported. Drop this with frontend/ once the renderer lives in apps/.
  "ignore": ["frontend/**"],
  "workspaces": {
    // The root holds only tooling; the Python app is not part of the TS monorepo.
    ".": {
      "entry": [],
      "project": [],
      // The frontend and e2e jobs in ci.yml, and the root vitest's catch-all *.spec.ts pattern, would
      // pull frontend/ in; each TS workspace below runs its own vitest plugin.
      "github-actions": false,
      "playwright": false,
      "vitest": { "config": ["vitest.config.ts"], "entry": [] }
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "entry": [
        "src/main.ts",
        "src/preload.cts",
        "src/storeProcess/main.ts",
        "scripts/*.mjs",
        "e2e/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx,cts}", "scripts/**/*.mjs", "e2e/**/*.ts"],
      // Loading its Playwright config would run prepareSpecs() (writes a spec tree); list e2e/ instead.
      "playwright": false,
      // macOS system tool the quit spec calls, not an npm package.
      "ignoreBinaries": ["pgrep"]
    },
    "frontend": {
      "entry": [
        "src/main.tsx",
        "tests/*.test.mjs",
        "tests/setup.mjs",
        "e2e/**/*.ts",
        "vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.mjs", "e2e/**/*.ts", "*.ts"],
      // The Playwright config is loaded through e2e/ above; node:test needs no plugin.
      "playwright": false
    },
    "tools/arch": {
      "entry": ["src/run.ts", "src/depcruise.ts", "depcruise.config.cjs"],
      "project": ["src/**/*.ts"],
      // Spawned by src/run.ts through its bin path, which knip cannot follow.
      "ignoreDependencies": ["sherif"]
    }
  }
}
