// Knip: unused files, exports, types and dependencies of the TypeScript workspaces.
// Run from the repo root by `pnpm arch:check` (tools/arch/src/run.ts).
{
  "$schema": "../../node_modules/.pnpm/knip@6.41.0/node_modules/knip/schema-jsonc.json",
  // Historical SPA reference files are outside the TypeScript workspace graph.
  "ignore": ["frontend/**"],
  "workspaces": {
    // The root holds only tooling; the Python app is not part of the TS monorepo.
    ".": {
      "entry": [],
      "project": [],
      // Each TS workspace below runs its own Vitest plugin.
      "github-actions": false,
      "playwright": false,
      "vitest": { "config": ["vitest.config.ts"], "entry": [] }
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/**/*.stories.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/node-host": {
      // Spawned by the host tests as a separate process (through its path), which knip cannot follow.
      "entry": ["src/testing/fixtureHost.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/host": {
      // Process entry points and the fake Python CLI are referenced by path, not imported.
      "entry": [
        "src/cli.ts",
        "src/testing/faultHost.ts",
        "src/testing/nativeCreationHost.ts",
        "src/testing/seedOverviewDemo.ts",
        "src/testing/syntheticCliHost.ts",
        "src/sync/harness/main.ts",
        "src/sync/harness/crashHost.ts",
        "src/sync/testing/fakeCashu.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      // Loaded by a test-only Node --import path before the real shim entry.
      "entry": ["src/testing/hostInterposer.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/desktop": {
      "entry": [
        "src/entry.ts",
        "src/preload.cts",
        // Loaded only by the disposable build/t46 Electron provider probe.
        "src/update/localhostProbe.ts",
        "renderer/main.tsx",
        "renderer/**/*.stories.tsx",
        "scripts/*.mjs",
        "e2e/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,cts}",
        "renderer/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "e2e/**/*.ts"
      ],
      // Loading its Playwright config would run prepareSpecs() (writes a spec tree); list e2e/ instead.
      "playwright": false,
      // macOS system tool the quit spec calls, not an npm package.
      "ignoreBinaries": ["pgrep"],
      // Invoked by scripts/package-macos.mjs through its CLI, not imported as a module.
      "ignoreDependencies": ["electron-builder"]
    },
    "tools/arch": {
      "entry": ["src/run.ts", "src/depcruise.ts", "depcruise.config.cjs"],
      "project": ["src/**/*.ts"],
      // Spawned by src/run.ts through its bin path, which knip cannot follow.
      "ignoreDependencies": ["sherif"]
    }
  }
}
