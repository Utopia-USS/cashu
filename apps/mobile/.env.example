# The phone's sync config, inlined by Metro at bundle time (src/platform/relayConfig.ts). Copy this
# file to .env.local (git-ignored) and fill ONE of the two blocks. Plain values, no quotes: Expo's .env
# parser cuts a double-quoted value at the first quote, so JSON in quotes arrives truncated.

# A real Firebase project (the web app's config from the Firebase console):
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=

# The local emulator (dev builds only; a release build ignores these). Leave the project block empty
# to use the `demo-cashu` project the host and `pnpm test:emulator` use. Loopback only, both or neither:
# the iOS simulator reaches the Mac's emulator on 127.0.0.1.
# EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
