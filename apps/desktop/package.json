{
  "name": "@cashu/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build-main.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:exhaustive": "CASHU_TEST_TIER=exhaustive vitest run --passWithNoTests",
    "dev": "node scripts/dev.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@cashu/host-protocol": "workspace:*",
    "@cashu/i18n": "workspace:*",
    "@cashu/node-host": "workspace:*",
    "@cashu/store": "workspace:*",
    "@cashu/store-react": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.1.0",
    "rolldown": "1.2.16"
  },
  "main": "dist/main.js",
  "description": "cashU desktop shell (Electron). Strangler v1: spawns the Python `cashu serve` as a sidecar; the renderer's store port is relayed by main to the local host (apps/host), started on demand."
}
