{
  "name": "@cashu/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build-main.mjs && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:exhaustive": "CASHU_TEST_TIER=exhaustive vitest run --passWithNoTests",
    "dev": "node scripts/dev.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@cashu/domain": "workspace:*",
    "@cashu/host-protocol": "workspace:*",
    "@cashu/i18n": "workspace:*",
    "@cashu/node-host": "workspace:*",
    "@cashu/store": "workspace:*",
    "@cashu/store-react": "workspace:*",
    "@cashu/ui": "workspace:*",
    "@cashu/ui-logic": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-virtual": "3.14.25",
    "electron-updater": "6.7.3",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.8.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "jsdom": "26.1.0",
    "rolldown": "1.2.16",
    "vite": "^5.4.11"
  },
  "main": "dist/main.js",
  "description": "cashU native desktop shell (Electron) with a supervised local host and an independent renderer."
}
