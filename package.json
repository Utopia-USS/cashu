{
  "name": "cashu-ts",
  "private": true,
  "type": "module",
  "description": "cashU TypeScript monorepo (migration lab). Python app and frontend/ live beside it.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:all": "vitest run",
    "test:exhaustive": "turbo run test:exhaustive --concurrency=1",
    "check": "turbo run typecheck lint test",
    "check:handoff": "pnpm check && pnpm test:exhaustive && pnpm arch:check",
    "arch:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types tools/arch/src/run.ts",
    "bundle:check": "pnpm --filter @cashu/mobile bundle:check",
    "format": "biome format --write .",
    "parity": "node --disable-warning=ExperimentalWarning --experimental-strip-types packages/parity/src/cli.ts",
    "cashu-next": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tools/node-ts/resolveTs.ts apps/cli/src/index.ts",
    "parity:produce": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tools/node-ts/resolveTs.ts packages/parity/src/producers/cli.ts",
    "parity:bridge": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tools/node-ts/resolveTs.ts apps/host/src/sync/harness/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.9"
}
