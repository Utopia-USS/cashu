# =============================================================================
#  cashU - .gitignore
#  RULE: no financial data or secrets ever land in the repo.
#  The whole data/ and statements/ dirs are ignored except the empty structure
#  (data/incoming/.gitkeep: the default folder of `cashu import-dir`; statements/<bank>/).
# =============================================================================

# --- Secrets & credentials ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# --- Local data (never leaves the machine) -----------------------------------
# Older checkouts kept the SQLite DB, backups, Open Banking sessions and keys under data/
# (now in the per-user data dir, see core/paths.py). Only data/incoming/ stays tracked.
data/*
!data/incoming/
data/incoming/*
!data/incoming/.gitkeep

# Bank statements (CSV) — real data. We keep only the directory structure.
statements/**
!statements/
!statements/README.md
!statements/*/
!statements/**/.gitkeep

# --- Frontend (React/Vite) ---------------------------------------------------
frontend/node_modules/
frontend/dist/
# built SPA served by FastAPI — regenerated by `npm run build`
src/cashu/api/webdist/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Agent artifacts & screenshots (local only) ------------------------------
/docs/fork/
/docs/specs/
/docs/progress/
/docs/design/
/screens/
/screenshots/
/*.png
/*.jpg
*.screenshot.png
.claude/worktrees/
frontend/test-results/
frontend/playwright-report/
frontend/e2e/output/

# --- System / IDE ------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
# Local agent config overrides (shared settings stay tracked)
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md

# Release config of this Mac (scripts/release_macos.sh): names and the public update key; secrets stay in the keychain
packaging/release.local.env
