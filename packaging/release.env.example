# Copy to packaging/release.local.env (git-ignored) and fill in. Names and the PUBLIC key only: every secret
# stays in the login keychain (packaging/RELEASING.md). scripts/release_macos.sh refuses to read the copy
# unless git ignores it.

# What `build/release/sparkle/bin/generate_keys -p` prints (step 3). Public: it is in every built app.
SPARKLE_PUBLIC_ED_KEY=""

# Developer ID signing and notarization: leave both empty for an ad-hoc release (no Developer ID yet; the
# first install on each Mac then needs "Open Anyway"). Set both together.
# `security find-identity -v -p codesigning` lists the identity (step 1).
DEVELOPER_ID_APPLICATION=""
# The profile name given to `xcrun notarytool store-credentials` (step 2).
NOTARY_KEYCHAIN_PROFILE=""

# Optional: the GitHub repo whose releases carry the update feed (default Utopia-USS/cashu).
# CASHU_UPDATE_REPO="Utopia-USS/cashu"
